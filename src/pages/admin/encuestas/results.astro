---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resultados">
  <div class="page">
    <header class="page-header">
      <div>
        <a href="/admin/encuestas" class="back-link">← Encuestas</a>
        <h1 class="page-title" id="surveyTitle">Resultados</h1>
        <p class="page-sub" id="totalCount"></p>
      </div>
    </header>

    <div id="loadingState" style="padding:60px 0;text-align:center;font-family:'Syne',sans-serif;color:#AAA;">Cargando resultados...</div>
    <div id="resultsWrap" style="display:none"></div>
  </div>
</AdminLayout>

<style is:global>
  .page { padding: 40px 48px; max-width: 800px; }
  .page-header { margin-bottom: 40px; }
  .back-link { font-family: 'Syne', sans-serif; font-size: 11px; color: #AAA; text-decoration: none; letter-spacing: 1px; display: block; margin-bottom: 6px; }
  .back-link:hover { color: #444; }
  .page-title { font-family: 'Bebas Neue', sans-serif; font-size: 42px; letter-spacing: 3px; color: #0A0A0A; }
  .page-sub { font-family: 'Syne', sans-serif; font-size: 14px; color: #888; margin-top: 4px; }

  .q-result { background: #FFF; border: 1px solid #EBEBEB; padding: 28px; margin-bottom: 16px; }
  .q-result-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #0A0A0A; margin-bottom: 4px; }
  .q-result-type { font-family: 'Syne', sans-serif; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #AAA; margin-bottom: 20px; }

  .option-bar { margin-bottom: 14px; }
  .option-bar-label { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .option-text { font-family: 'Syne', sans-serif; font-size: 13px; color: #333; }
  .option-count { font-family: 'Bebas Neue', sans-serif; font-size: 16px; color: #0A0A0A; letter-spacing: 1px; }
  .bar-track { height: 6px; background: #F0F0F0; border-radius: 3px; overflow: hidden; }
  .bar-fill { height: 100%; background: #0A0A0A; border-radius: 3px; transition: width 0.6s ease; }

  .text-answers { display: flex; flex-direction: column; gap: 8px; }
  .text-answer {
    padding: 10px 14px; background: #F8F8F8; border-left: 3px solid #E0E0E0;
    font-family: 'Syne', sans-serif; font-size: 13px; color: #444; line-height: 1.5;
  }
  .no-answers { font-family: 'Syne', sans-serif; font-size: 13px; color: #AAA; font-style: italic; }
</style>

<script>
  const API = 'https://api.arkangroup.mx';
  const id = new URLSearchParams(window.location.search).get('id');

  async function loadResults() {
    if (!id) { window.location.href = '/admin/encuestas'; return; }
    try {
      const res = await fetch(`${API}/surveys/${id}/results`, { credentials: 'include' });
      if (!res.ok) throw new Error();
      const json = await res.json();
      const data = json?.data ?? json;

      document.getElementById('surveyTitle')!.textContent = data.title;
      document.getElementById('totalCount')!.textContent =
        `${data.totalResponses} respuesta${data.totalResponses !== 1 ? 's' : ''} recibida${data.totalResponses !== 1 ? 's' : ''}`;

      const wrap = document.getElementById('resultsWrap')!;

      if (!data.results?.length) {
        wrap.innerHTML = '<p style="font-family:\'Syne\',sans-serif;color:#AAA;padding:40px 0;text-align:center;">Sin preguntas aún.</p>';
      } else {
        wrap.innerHTML = data.results.map((q: any, qi: number) => {
          const typeLabel = q.type === 'SINGLE' ? 'Opción única' : q.type === 'MULTIPLE' ? 'Opción múltiple' : 'Respuesta abierta';

          if (q.type === 'TEXT') {
            const answers = q.answers ?? [];
            return `
              <div class="q-result">
                <p class="q-result-title">${String(qi + 1).padStart(2, '0')}. ${q.text}</p>
                <p class="q-result-type">${typeLabel}</p>
                ${answers.length
                  ? `<div class="text-answers">${answers.map((a: string) => `<div class="text-answer">${a}</div>`).join('')}</div>`
                  : '<p class="no-answers">Sin respuestas todavía.</p>'}
              </div>`;
          }

          const total = q.options?.reduce((s: number, o: any) => s + o.count, 0) || 0;
          const bars = (q.options ?? []).map((opt: any) => {
            const pct = total > 0 ? Math.round((opt.count / total) * 100) : 0;
            return `
              <div class="option-bar">
                <div class="option-bar-label">
                  <span class="option-text">${opt.text}</span>
                  <span class="option-count">${opt.count} <span style="font-family:'Syne',sans-serif;font-size:11px;color:#AAA;font-weight:400">(${pct}%)</span></span>
                </div>
                <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
              </div>`;
          }).join('');

          return `
            <div class="q-result">
              <p class="q-result-title">${String(qi + 1).padStart(2, '0')}. ${q.text}</p>
              <p class="q-result-type">${typeLabel} · ${total} respuesta${total !== 1 ? 's' : ''}</p>
              ${bars || '<p class="no-answers">Sin respuestas todavía.</p>'}
            </div>`;
        }).join('');
      }

      document.getElementById('loadingState')!.style.display = 'none';
      wrap.style.display = 'block';
    } catch {
      document.getElementById('loadingState')!.textContent = 'Error al cargar los resultados.';
    }
  }

  document.addEventListener('arkan:auth-ready', loadResults);
</script>
