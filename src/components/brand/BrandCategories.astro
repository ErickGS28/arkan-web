---
import type { Brand } from '../../data/brands';

interface Props { brand: Brand; apiUrl?: string; apiBrand?: string; }
const { brand, apiUrl, apiBrand } = Astro.props;

const waBase = 'https://wa.me/525564991943';
const waUrl = (cat: string) =>
  `${waBase}?text=${encodeURIComponent(`Hola, me interesa información sobre ${cat} de ${brand.name}`)}`;
---

<section class="categories" id="lookbook">
  {brand.categories.map((cat, i) => (
    <div class:list={['category', { 'category--dark': i % 2 !== 0 }]}>
      <div class="cat-inner">

        <header class="cat-header">
          <div class="cat-title-row">
            <span class="cat-index">0{i + 1}</span>
            <h2 class="cat-name">{cat.name}</h2>
          </div>
          <div class="cat-rule"></div>
          <p class="cat-desc">{cat.description}</p>
        </header>

        <div class="cat-slider-wrap">
          <div class="cat-slider" data-slider>
            {cat.images.map((src, j) => (
              <div class="cat-slide">
                <img
                  src={src}
                  alt={`${cat.name} ${j + 1}`}
                  loading={j > 2 ? 'lazy' : 'eager'}
                />
              </div>
            ))}
          </div>

          {cat.images.length > 3 && (
            <div class="cat-nav">
              <button class="cat-nav-btn cat-nav-prev" data-dir="-1" aria-label="Anterior">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12L4 7l5-5"/>
                </svg>
              </button>
              <button class="cat-nav-btn cat-nav-next" data-dir="1" aria-label="Siguiente">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 2l5 5-5 5"/>
                </svg>
              </button>
            </div>
          )}
        </div>

        <div class="cat-cta">
          <a href={waUrl(cat.name)} target="_blank" rel="noopener noreferrer" class="btn-wa">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Consultar por WhatsApp
          </a>
        </div>

      </div>
    </div>
  ))}
</section>

<script>
  const GAP = 6;
  const VISIBLE = 3;

  function sizeSlides() {
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach(slider => {
      const w = Math.floor((slider.offsetWidth - GAP * (VISIBLE - 1)) / VISIBLE);
      if (w <= 0) return;
      slider.querySelectorAll<HTMLElement>('.cat-slide').forEach(slide => {
        slide.style.width = w + 'px';
        slide.style.minWidth = w + 'px';
      });
    });
  }

  document.addEventListener('DOMContentLoaded', sizeSlides);
  window.addEventListener('resize', sizeSlides);

  // Nav buttons
  document.querySelectorAll<HTMLButtonElement>('.cat-nav-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('.cat-slider-wrap');
      const slider = wrap?.querySelector<HTMLElement>('[data-slider]');
      if (!slider) return;
      const slide = slider.querySelector<HTMLElement>('.cat-slide');
      const slideW = (slide?.offsetWidth ?? 0) + GAP;
      slider.scrollBy({ left: Number(btn.dataset.dir) * slideW, behavior: 'smooth' });
    });
  });
</script>

{apiUrl && apiBrand && (
<script define:vars={{ apiUrl, apiBrand }}>
  async function loadApiCategories() {
    try {
      const res = await fetch(`${apiUrl}/brands/categories?brand=${apiBrand}`);
      if (!res.ok) return;
      const json = await res.json();
      const cats = Array.isArray(json) ? json : (json?.data ?? []);
      if (!cats.length) return;

      const mapped = cats
        .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
        .map(cat => ({
          name: cat.name,
          description: cat.description ?? '',
          images: (cat.images ?? [])
            .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
            .map(img => img.url),
        }));

      const hasImages = mapped.some(c => c.images.length > 0);
      if (!hasImages) return;

      const GAP = 6;
      const VISIBLE = 3;

      const sections = document.querySelectorAll('.category');
      mapped.forEach((cat, i) => {
        const section = sections[i];
        if (!section) return;

        const slider = section.querySelector('[data-slider]');
        if (!slider || !cat.images.length) return;

        slider.innerHTML = cat.images.map((src, j) => `
          <div class="cat-slide">
            <img src="${src}" alt="${cat.name} ${j + 1}" loading="${j > 2 ? 'lazy' : 'eager'}" />
          </div>
        `).join('');

        const w = Math.floor((slider.offsetWidth - GAP * (VISIBLE - 1)) / VISIBLE);
        if (w > 0) {
          slider.querySelectorAll('.cat-slide').forEach(slide => {
            slide.style.width = w + 'px';
            slide.style.minWidth = w + 'px';
          });
        }

        const navWrap = section.querySelector('.cat-nav');
        if (navWrap) {
          navWrap.style.display = cat.images.length > VISIBLE ? 'flex' : 'none';
        } else if (cat.images.length > VISIBLE) {
          const nav = document.createElement('div');
          nav.className = 'cat-nav';
          nav.innerHTML = `
            <button class="cat-nav-btn cat-nav-prev" data-dir="-1" aria-label="Anterior">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12L4 7l5-5"/></svg>
            </button>
            <button class="cat-nav-btn cat-nav-next" data-dir="1" aria-label="Siguiente">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2l5 5-5 5"/></svg>
            </button>`;
          slider.closest('.cat-slider-wrap')?.appendChild(nav);
          nav.querySelectorAll('.cat-nav-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const s = btn.closest('.cat-slider-wrap')?.querySelector('[data-slider]');
              const slide = s?.querySelector('.cat-slide');
              const slideW = (slide?.offsetWidth ?? 0) + GAP;
              s?.scrollBy({ left: Number(btn.dataset.dir) * slideW, behavior: 'smooth' });
            });
          });
        }
      });
    } catch (_) {}
  }

  document.addEventListener('DOMContentLoaded', loadApiCategories);
</script>
)}

<style is:global>
  .categories { display: flex; flex-direction: column; }

  .category       { background: #FFFFFF; }
  .category--dark { background: #0A0A0A; }

  .cat-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 96px 80px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Header */
  .cat-header { display: flex; flex-direction: column; gap: 16px; }

  .cat-title-row { display: flex; align-items: baseline; gap: 20px; }

  .cat-index {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px; line-height: 1; letter-spacing: 2px;
  }
  .category       .cat-index { color: #BBBBBB; }
  .category--dark .cat-index { color: #555; }

  .cat-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(40px, 5vw, 72px);
    letter-spacing: 4px; line-height: 1;
  }
  .category       .cat-name { color: #0A0A0A; }
  .category--dark .cat-name { color: #F0F0F0; }

  .cat-rule { width: 100%; height: 1px; }
  .category       .cat-rule { background: #E8E8E8; }
  .category--dark .cat-rule { background: #1A1A1A; }

  .cat-desc {
    font-family: 'Syne', sans-serif;
    font-size: 15px; line-height: 1.8; max-width: 600px;
  }
  .category       .cat-desc { color: #666; }
  .category--dark .cat-desc { color: #555; }

  /* Slider */
  .cat-slider-wrap { display: flex; flex-direction: column; gap: 16px; }

  [data-slider] {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  [data-slider]::-webkit-scrollbar { display: none; }

  .cat-slide {
    flex-shrink: 0;
    scroll-snap-align: start;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .cat-slide img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s ease, filter 0.4s ease;
    filter: brightness(0.95);
  }
  .cat-slide:hover img { transform: scale(1.04); filter: brightness(1); }

  /* Nav arrows */
  .cat-nav { display: flex; gap: 8px; }

  .cat-nav-btn {
    width: 40px; height: 40px;
    background: transparent;
    border: 1px solid;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }
  .category       .cat-nav-btn { border-color: #D0D0D0; color: #0A0A0A; }
  .category--dark .cat-nav-btn { border-color: #2A2A2A; color: #888; }
  .cat-nav-btn:hover { opacity: 0.55; }

  /* CTA */
  .cat-cta { display: flex; justify-content: center; }

  .btn-wa {
    display: inline-flex; align-items: center; gap: 10px;
    background: #25D366; color: #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 12px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    padding: 16px 36px; text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .btn-wa:hover { background: #20BA58; transform: translateY(-2px); }

  @media (max-width: 900px) {
    .cat-inner { padding: 72px 40px; }
  }
  @media (max-width: 768px) {
    .cat-inner { padding: 56px 24px; gap: 32px; }
    .cat-name { font-size: clamp(32px, 10vw, 52px); }
    .cat-desc { max-width: 100%; font-size: 14px; }
  }
  @media (max-width: 480px) {
    .cat-inner { padding: 48px 20px; gap: 24px; }
    .btn-wa { width: 100%; justify-content: center; }
  }
</style>
