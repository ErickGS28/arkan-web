---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Nuevo Post">
  <div class="page">
    <header class="page-header">
      <div>
        <a href="/admin/blog" class="back-link">← Blog</a>
        <h1 class="page-title">Nuevo Post</h1>
      </div>
      <div class="header-actions">
        <button class="btn-draft" id="btnDraft">Guardar borrador</button>
        <button class="btn-publish" id="btnPublish">Publicar</button>
      </div>
    </header>

    <form id="postForm" class="post-form" autocomplete="off">
      <div class="form-layout">
        <!-- Main column -->
        <div class="form-main">
          <div class="field">
            <label class="field-label">Título <span class="req">*</span></label>
            <input class="field-input" id="title" name="title" type="text" placeholder="Escribe el título del artículo" required />
          </div>

          <div class="field">
            <label class="field-label">Resumen (excerpt) <span class="req">*</span></label>
            <textarea class="field-input field-textarea" id="excerpt" name="excerpt" rows="3" placeholder="Descripción corta del artículo (aparece en el listado)" required></textarea>
          </div>

          <div class="field">
            <label class="field-label">Contenido <span class="req">*</span></label>
            <div class="editor-toolbar" id="editorToolbar">
              <button type="button" data-cmd="bold" title="Negrita"><b>B</b></button>
              <button type="button" data-cmd="italic" title="Cursiva"><i>I</i></button>
              <button type="button" data-cmd="h2" title="Subtítulo">H2</button>
              <button type="button" data-cmd="p" title="Párrafo">¶</button>
            </div>
            <div class="rich-editor" id="richEditor" contenteditable="true" data-placeholder="Escribe el contenido del artículo..."></div>
            <textarea id="contentHidden" name="content" style="display:none"></textarea>
          </div>
        </div>

        <!-- Side column -->
        <div class="form-side">
          <div class="side-card">
            <p class="side-card-title">Imagen de portada</p>
            <div class="cover-upload" id="coverUploadArea">
              <div class="cover-placeholder" id="coverPlaceholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p>Seleccionar imagen</p>
              </div>
              <img id="coverPreview" class="cover-preview" style="display:none" alt="Cover preview" />
            </div>
            <input type="file" id="coverFile" accept="image/*" style="display:none" />
            <input type="hidden" id="coverImg" name="coverImg" />
            <p class="upload-status" id="uploadStatus"></p>
            <button type="button" class="btn-remove-cover" id="btnRemoveCover" style="display:none">Quitar imagen</button>
          </div>

          <div class="side-card">
            <p class="side-card-title">Slug (auto)</p>
            <div class="slug-display" id="slugDisplay">Se generará del título</div>
          </div>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .page { padding: 40px 48px; max-width: 1100px; }

  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .back-link {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    color: #AAA;
    text-decoration: none;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 6px;
    transition: color 0.15s;
  }
  .back-link:hover { color: #444; }

  .page-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 42px;
    letter-spacing: 3px;
    color: #0A0A0A;
  }

  .header-actions { display: flex; gap: 10px; align-items: center; }

  .btn-draft, .btn-publish {
    padding: 11px 24px;
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s;
  }
  .btn-draft { background: transparent; border-color: #CCCCCC; color: #555; }
  .btn-draft:hover { border-color: #888; color: #111; background: #F5F5F5; }
  .btn-publish { background: #0A0A0A; color: #FFFFFF; border-color: #0A0A0A; }
  .btn-publish:hover { background: #333; }
  .btn-draft:disabled, .btn-publish:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Form layout */
  .form-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 28px;
    align-items: start;
  }

  .field { margin-bottom: 24px; }

  .field-label {
    display: block;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #555;
    margin-bottom: 8px;
  }
  .req { color: #D33; }

  .field-input {
    width: 100%;
    padding: 12px 16px;
    background: #FFFFFF;
    border: 1px solid #DCDCDC;
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    color: #0A0A0A;
    outline: none;
    transition: border-color 0.15s;
    resize: vertical;
  }
  .field-input:focus { border-color: #0A0A0A; }
  .field-input::placeholder { color: #BBBBBB; }
  .field-textarea { min-height: 88px; }

  /* Rich editor */
  .editor-toolbar {
    display: flex;
    gap: 4px;
    padding: 8px 10px;
    background: #F8F8F8;
    border: 1px solid #E0E0E0;
    border-bottom: none;
  }
  .editor-toolbar button {
    padding: 4px 10px;
    background: transparent;
    border: 1px solid transparent;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    color: #555;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.1s;
  }
  .editor-toolbar button:hover { background: #EEE; border-color: #DDD; }

  .rich-editor {
    min-height: 320px;
    padding: 18px;
    background: #FFFFFF;
    border: 1px solid #DCDCDC;
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #0A0A0A;
    outline: none;
    overflow-y: auto;
  }
  .rich-editor:focus { border-color: #0A0A0A; }
  .rich-editor:empty::before {
    content: attr(data-placeholder);
    color: #BBBBBB;
    pointer-events: none;
  }

  /* Side column */
  .side-card {
    background: #FFFFFF;
    border: 1px solid #E8E8E8;
    padding: 20px;
    margin-bottom: 16px;
  }

  .side-card-title {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 14px;
  }

  /* Cover upload */
  .cover-upload {
    border: 2px dashed #E0E0E0;
    cursor: pointer;
    transition: border-color 0.2s;
    overflow: hidden;
    aspect-ratio: 16/9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FAFAFA;
    position: relative;
  }
  .cover-upload:hover { border-color: #AAA; }

  .cover-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #CCC;
  }
  .cover-placeholder p {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .cover-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .upload-status {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    color: #AAA;
    margin-top: 8px;
    min-height: 16px;
    letter-spacing: 0.5px;
  }

  .btn-remove-cover {
    margin-top: 8px;
    background: transparent;
    border: none;
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    color: #CC3333;
    letter-spacing: 1px;
    cursor: pointer;
    padding: 0;
    text-transform: uppercase;
  }
  .btn-remove-cover:hover { text-decoration: underline; }

  .slug-display {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    color: #777;
    word-break: break-all;
    line-height: 1.5;
    min-height: 20px;
  }
</style>

<script>
  const API = 'http://localhost:4013';

  // Slug preview
  const titleInput = document.getElementById('title') as HTMLInputElement;
  const slugDisplay = document.getElementById('slugDisplay')!;

  titleInput?.addEventListener('input', () => {
    const slug = titleInput.value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    slugDisplay.textContent = slug || 'Se generará del título';
  });

  // Rich editor toolbar
  document.querySelectorAll('#editorToolbar button').forEach(btn => {
    btn.addEventListener('click', () => {
      const cmd = (btn as HTMLElement).dataset.cmd;
      const editor = document.getElementById('richEditor')!;
      editor.focus();
      if (cmd === 'h2') {
        document.execCommand('formatBlock', false, 'h2');
      } else if (cmd === 'p') {
        document.execCommand('formatBlock', false, 'p');
      } else if (cmd === 'bold') {
        document.execCommand('bold');
      } else if (cmd === 'italic') {
        document.execCommand('italic');
      }
    });
  });

  // Cover image upload
  const coverUploadArea = document.getElementById('coverUploadArea')!;
  const coverFile = document.getElementById('coverFile') as HTMLInputElement;
  const coverPreview = document.getElementById('coverPreview') as HTMLImageElement;
  const coverPlaceholder = document.getElementById('coverPlaceholder')!;
  const coverImgInput = document.getElementById('coverImg') as HTMLInputElement;
  const uploadStatus = document.getElementById('uploadStatus')!;
  const btnRemoveCover = document.getElementById('btnRemoveCover')!;

  function showCoverPreview(src: string) {
    coverPreview.src = src;
    coverPreview.style.display = 'block';
    coverPlaceholder.style.display = 'none';
    btnRemoveCover.style.display = 'block';
  }

  coverUploadArea.addEventListener('click', () => coverFile.click());

  coverFile.addEventListener('change', async () => {
    const file = coverFile.files?.[0];
    if (!file) return;

    // Show local preview instantly
    const localUrl = URL.createObjectURL(file);
    showCoverPreview(localUrl);
    uploadStatus.textContent = 'Subiendo imagen...';

    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch(`${API}/blog/upload-image`, {
        method: 'POST',
        credentials: 'include',
        body: formData,
      });
      if (!res.ok) throw new Error();
      const json = await res.json();
      const url = json?.data?.url ?? json?.url;
      coverImgInput.value = url;
      coverPreview.src = url; // replace local blob with real URL
      uploadStatus.textContent = '';
      (window as any).toast?.success('Imagen subida correctamente.');
    } catch {
      coverImgInput.value = '';
      uploadStatus.textContent = 'Error al subir. La imagen no se guardará.';
      (window as any).toast?.error('Error al subir la imagen.');
    }
  });

  btnRemoveCover.addEventListener('click', (e) => {
    e.stopPropagation();
    coverImgInput.value = '';
    coverPreview.style.display = 'none';
    coverPlaceholder.style.display = 'flex';
    btnRemoveCover.style.display = 'none';
    uploadStatus.textContent = '';
    coverFile.value = '';
  });

  // Submit
  async function submitPost(status: 'DRAFT' | 'PUBLISHED') {
    const title = (document.getElementById('title') as HTMLInputElement).value.trim();
    const excerpt = (document.getElementById('excerpt') as HTMLTextAreaElement).value.trim();
    const content = document.getElementById('richEditor')!.innerHTML.trim();
    const coverImg = (document.getElementById('coverImg') as HTMLInputElement).value || undefined;

    if (!title || !excerpt || !content) {
      (window as any).toast?.error('Completa título, resumen y contenido.');
      return;
    }

    const buttons = document.querySelectorAll('.btn-draft, .btn-publish') as NodeListOf<HTMLButtonElement>;
    buttons.forEach(b => b.disabled = true);

    try {
      const res = await fetch(`${API}/blog`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, excerpt, content, coverImg, status }),
      });
      if (!res.ok) throw new Error();
      (window as any).toast?.success(status === 'PUBLISHED' ? 'Post publicado.' : 'Borrador guardado.');
      setTimeout(() => { window.location.href = '/admin/blog'; }, 800);
    } catch {
      (window as any).toast?.error('Error al guardar el post.');
      buttons.forEach(b => b.disabled = false);
    }
  }

  document.getElementById('btnDraft')?.addEventListener('click', () => submitPost('DRAFT'));
  document.getElementById('btnPublish')?.addEventListener('click', () => submitPost('PUBLISHED'));
</script>
