---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Nuevo Post">
  <link slot="head" rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css" />

  <div class="page">
    <header class="page-header">
      <div>
        <a href="/admin/blog" class="back-link">← Blog</a>
        <h1 class="page-title">Nuevo Post</h1>
      </div>
      <div class="header-actions">
        <button class="btn-draft" id="btnDraft">Borrador</button>
        <button class="btn-publish" id="btnPublish">Publicar</button>
      </div>
    </header>

    <form id="postForm" class="post-form" autocomplete="off">
      <div class="form-layout">
        <!-- Main column -->
        <div class="form-main">
          <div class="field">
            <label class="field-label">Título <span class="req">*</span></label>
            <input class="field-input field-title" id="title" name="title" type="text" placeholder="Escribe el título del artículo" required />
          </div>

          <div class="field">
            <label class="field-label">Resumen <span class="req">*</span></label>
            <textarea class="field-input field-textarea" id="excerpt" name="excerpt" rows="3" placeholder="Descripción breve que aparece en el listado" required></textarea>
          </div>

          <div class="field">
            <label class="field-label">Contenido <span class="req">*</span></label>
            <div class="editor-wrap">
              <div id="quill-editor"></div>
            </div>
          </div>
        </div>

        <!-- Side column -->
        <div class="form-side">
          <div class="side-card ai-card">
            <p class="side-card-title">Generar con IA</p>
            <textarea class="ai-topic" id="aiTopic" rows="3" placeholder="Tema o instrucción. Ej: por qué el denim colombiano es mejor inversión para un distribuidor"></textarea>
            <button type="button" class="btn-ai" id="btnGenerateAi">
              <svg class="ai-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M12 2l1.8 4.6L18.5 8l-4.7 1.4L12 14l-1.8-4.6L5.5 8l4.7-1.4z"/>
                <path d="M19 14l.9 2.3 2.3.9-2.3.9L19 20l-.9-2.3L15.8 17l2.3-.9z"/>
              </svg>
              <span class="ai-spinner" aria-hidden="true"></span>
              <span class="btn-ai-label">Generar contenido</span>
            </button>
            <p class="ai-hint">Redacta título, resumen y contenido alineados con la filosofía de Arkán.</p>
          </div>

          <div class="side-card">
            <p class="side-card-title">Imagen de portada</p>
            <div class="cover-upload" id="coverUploadArea">
              <div class="cover-placeholder" id="coverPlaceholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" width="32" height="32">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                <p>Haz clic para seleccionar</p>
                <span>JPG, PNG · 16:9 recomendado</span>
              </div>
              <img id="coverPreview" class="cover-preview" style="display:none" alt="Preview" />
              <div class="cover-uploading" id="coverUploading" style="display:none">
                <div class="upload-spinner"></div>
                <span>Subiendo…</span>
              </div>
            </div>
            <input type="file" id="coverFile" accept="image/*" style="display:none" />
            <input type="hidden" id="coverImg" name="coverImg" />
            <button type="button" class="btn-remove-cover" id="btnRemoveCover" style="display:none">Quitar imagen</button>
          </div>

          <div class="side-card">
            <p class="side-card-title">Slug (auto)</p>
            <div class="slug-display" id="slugDisplay">Se generará del título</div>
          </div>
        </div>
      </div>
    </form>
  </div>
</AdminLayout>

<style>
  .page { padding: 48px 56px; max-width: 1100px; }

  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 36px;
    gap: 16px;
  }

  .back-link {
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    color: #BBBBBB;
    text-decoration: none;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 8px;
    transition: color 0.15s;
  }
  .back-link:hover { color: #555; }

  .page-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 44px;
    letter-spacing: 3px;
    color: #0A0A0A;
    line-height: 1;
  }

  .header-actions { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }

  .btn-draft, .btn-publish {
    padding: 12px 24px;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s;
  }
  .btn-draft { background: #FFFFFF; border-color: #D8D8D8; color: #555; }
  .btn-draft:hover { border-color: #888; color: #111; }
  .btn-publish { background: #0A0A0A; color: #FFFFFF; border-color: #0A0A0A; }
  .btn-publish:hover { background: #2A2A2A; }
  .btn-draft:disabled, .btn-publish:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Form layout */
  .form-layout {
    display: grid;
    grid-template-columns: 1fr 290px;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 980px) {
    .form-layout { grid-template-columns: 1fr; gap: 28px; }
  }

  .field { margin-bottom: 28px; }

  .field-label {
    display: block;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 10px;
  }
  .req { color: #EF4444; }

  .field-input {
    width: 100%;
    padding: 13px 16px;
    background: #FFFFFF;
    border: 1px solid #E4E4E2;
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    color: #0A0A0A;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    resize: vertical;
  }
  .field-input:focus { border-color: #0A0A0A; box-shadow: 0 0 0 3px rgba(10,10,10,0.06); }
  .field-input::placeholder { color: #CCCCCC; }
  .field-title { font-size: 18px; font-weight: 600; }
  .field-textarea { min-height: 90px; line-height: 1.7; }

  /* Quill editor */
  .editor-wrap { border: 1px solid #E4E4E2; background: #FFFFFF; }
  .editor-wrap:focus-within { border-color: #0A0A0A; box-shadow: 0 0 0 3px rgba(10,10,10,0.06); }

  #quill-editor { min-height: 360px; }

  /* Side column */
  .side-card {
    background: #FFFFFF;
    border: 1px solid #E4E4E2;
    padding: 22px;
    margin-bottom: 16px;
  }

  .side-card-title {
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #AAAAAA;
    margin-bottom: 14px;
  }

  /* Cover upload */
  .cover-upload {
    border: 2px dashed #E4E4E2;
    cursor: pointer;
    transition: border-color 0.2s;
    overflow: hidden;
    aspect-ratio: 16/9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FAFAF8;
    position: relative;
    border-radius: 2px;
  }
  .cover-upload:hover { border-color: #AAAAAA; }

  .cover-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #CCC;
    text-align: center;
    padding: 12px;
  }
  .cover-placeholder p {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: #AAA;
  }
  .cover-placeholder span {
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    color: #CCC;
    letter-spacing: 0.5px;
  }

  .cover-preview {
    width: 100%; height: 100%;
    object-fit: cover;
    position: absolute; inset: 0;
  }

  .cover-uploading {
    position: absolute; inset: 0;
    background: rgba(255,255,255,0.85);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    letter-spacing: 1px;
    color: #888;
  }
  .upload-spinner {
    width: 24px; height: 24px;
    border: 2px solid #E8E8E8;
    border-top-color: #0A0A0A;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .btn-remove-cover {
    margin-top: 10px;
    width: 100%;
    padding: 7px;
    background: transparent;
    border: 1px solid #FECACA;
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #EF4444;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.15s;
  }
  .btn-remove-cover:hover { background: #FEF2F2; }

  .slug-display {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    color: #AAAAAA;
    word-break: break-all;
    line-height: 1.6;
    padding: 10px 12px;
    background: #FAFAF8;
    border: 1px solid #F0F0EE;
    min-height: 40px;
  }

  /* AI generation card */
  .ai-card { background: #0A0A0A; border-color: #0A0A0A; }
  .ai-card .side-card-title { color: #888888; }

  .ai-topic {
    width: 100%;
    padding: 11px 12px;
    background: #161616;
    border: 1px solid #2A2A2A;
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    color: #F0F0F0;
    outline: none;
    resize: vertical;
    min-height: 76px;
    transition: border-color 0.15s;
  }
  .ai-topic:focus { border-color: #555; }
  .ai-topic::placeholder { color: #666; }

  .btn-ai {
    margin-top: 12px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: #FFFFFF;
    border: 1px solid #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #0A0A0A;
    cursor: pointer;
    transition: opacity 0.15s, background 0.15s;
  }
  .btn-ai:hover { background: #E8E8E8; }
  .btn-ai:disabled { opacity: 0.55; cursor: not-allowed; }

  .ai-spinner {
    display: none;
    width: 14px; height: 14px;
    border: 2px solid rgba(10,10,10,0.25);
    border-top-color: #0A0A0A;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  .btn-ai.loading .ai-icon { display: none; }
  .btn-ai.loading .ai-spinner { display: inline-block; }

  .ai-hint {
    margin-top: 12px;
    font-family: 'Syne', sans-serif;
    font-size: 10.5px;
    line-height: 1.5;
    color: #777;
    letter-spacing: 0.2px;
  }
</style>

<!-- Custom Quill styles to match our design -->
<style is:global>
  .ql-toolbar.ql-snow {
    border: none !important;
    border-bottom: 1px solid #E4E4E2 !important;
    background: #FAFAF8;
    padding: 10px 12px !important;
    font-family: 'Syne', sans-serif;
  }
  .ql-container.ql-snow {
    border: none !important;
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    color: #0A0A0A;
  }
  .ql-editor {
    min-height: 360px;
    padding: 20px 22px !important;
    line-height: 1.85 !important;
  }
  .ql-editor.ql-blank::before {
    color: #CCCCCC !important;
    font-style: normal !important;
    font-family: 'Syne', sans-serif;
  }
  .ql-snow .ql-stroke { stroke: #555 !important; }
  .ql-snow .ql-fill  { fill: #555 !important; }
  .ql-snow.ql-toolbar button:hover .ql-stroke,
  .ql-snow.ql-toolbar button.ql-active .ql-stroke { stroke: #0A0A0A !important; }
  .ql-snow.ql-toolbar button:hover .ql-fill,
  .ql-snow.ql-toolbar button.ql-active .ql-fill  { fill: #0A0A0A !important; }
  .ql-snow.ql-toolbar button { border-radius: 2px !important; }
  .ql-snow.ql-toolbar button:hover { background: #F0F0EE !important; }
  .ql-snow.ql-toolbar button.ql-active { background: #E8E8E6 !important; }
  .ql-snow .ql-picker-label { color: #555 !important; }
  .ql-editor h1, .ql-editor h2, .ql-editor h3 {
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 1px;
    color: #0A0A0A;
  }
  .ql-editor blockquote {
    border-left: 3px solid #E0E0E0 !important;
    color: #777 !important;
    font-style: italic;
  }
  .ql-editor a { color: #0A0A0A; text-decoration: underline; }
</style>

<script>
  const API = 'https://api.arkangroup.mx';

  let quillInstance: any = null;

  // Slug preview
  const titleInput = document.getElementById('title') as HTMLInputElement;
  const slugDisplay = document.getElementById('slugDisplay')!;

  titleInput?.addEventListener('input', () => {
    const slug = titleInput.value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    slugDisplay.textContent = slug || 'Se generará del título';
  });

  // Load Quill from CDN
  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).Quill) { resolve(); return; }
      const s = document.createElement('script');
      s.src = src;
      s.onload = () => resolve();
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  async function initEditor() {
    await loadScript('https://cdn.quilljs.com/1.3.7/quill.min.js');
    const Quill = (window as any).Quill;

    quillInstance = new Quill('#quill-editor', {
      theme: 'snow',
      placeholder: 'Escribe el contenido del artículo…',
      modules: {
        toolbar: [
          [{ header: [2, 3, false] }],
          ['bold', 'italic', 'underline'],
          ['blockquote', 'code-block'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link'],
          ['clean'],
        ],
      },
    });
  }

  initEditor();

  // AI content generation
  const btnGenerateAi = document.getElementById('btnGenerateAi') as HTMLButtonElement | null;
  const aiTopic = document.getElementById('aiTopic') as HTMLTextAreaElement | null;

  async function generateAiContent() {
    if (!btnGenerateAi || !aiTopic) return;
    const topic = aiTopic.value.trim();
    if (!topic) {
      (window as any).toast?.error('Escribe un tema o instrucción para la IA.');
      aiTopic.focus();
      return;
    }

    const titleEl   = document.getElementById('title') as HTMLInputElement;
    const excerptEl = document.getElementById('excerpt') as HTMLTextAreaElement;
    const hasContent =
      !!titleEl.value.trim() ||
      !!excerptEl.value.trim() ||
      (quillInstance && quillInstance.getText().trim().length > 0);

    if (hasContent && !confirm('Esto reemplazará el título, resumen y contenido actuales. ¿Continuar?')) {
      return;
    }

    btnGenerateAi.disabled = true;
    btnGenerateAi.classList.add('loading');
    const label = btnGenerateAi.querySelector('.btn-ai-label')!;
    const prevLabel = label.textContent;
    label.textContent = 'Generando…';

    try {
      const res = await fetch(`${API}/blog/generate`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ topic, title: titleEl.value.trim() || undefined }),
      });
      if (!res.ok) throw new Error();
      const json = await res.json();
      const data = json?.data ?? json;
      if (!data?.content) throw new Error();

      titleEl.value = data.title || titleEl.value;
      excerptEl.value = data.excerpt || excerptEl.value;
      if (quillInstance) quillInstance.root.innerHTML = data.content;
      titleEl.dispatchEvent(new Event('input')); // refresca el slug
      (window as any).toast?.success('Contenido generado con IA.');
    } catch {
      (window as any).toast?.error('No se pudo generar el contenido. Intenta de nuevo.');
    } finally {
      btnGenerateAi.disabled = false;
      btnGenerateAi.classList.remove('loading');
      label.textContent = prevLabel;
    }
  }

  btnGenerateAi?.addEventListener('click', generateAiContent);

  // Cover image upload
  const coverUploadArea = document.getElementById('coverUploadArea')!;
  const coverFile       = document.getElementById('coverFile') as HTMLInputElement;
  const coverPreview    = document.getElementById('coverPreview') as HTMLImageElement;
  const coverPlaceholder = document.getElementById('coverPlaceholder')!;
  const coverImgInput   = document.getElementById('coverImg') as HTMLInputElement;
  const coverUploading  = document.getElementById('coverUploading')!;
  const btnRemoveCover  = document.getElementById('btnRemoveCover')!;

  function showCoverPreview(src: string) {
    coverPreview.src = src;
    coverPreview.style.display = 'block';
    coverPlaceholder.style.display = 'none';
    coverUploading.style.display = 'none';
    btnRemoveCover.style.display = 'block';
  }

  coverUploadArea.addEventListener('click', () => coverFile.click());

  coverFile.addEventListener('change', async () => {
    const file = coverFile.files?.[0];
    if (!file) return;

    showCoverPreview(URL.createObjectURL(file));
    coverUploading.style.display = 'flex';

    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch(`${API}/blog/upload-image`, {
        method: 'POST',
        credentials: 'include',
        body: formData,
      });
      if (!res.ok) throw new Error();
      const json = await res.json();
      const url = json?.data?.url ?? json?.url;
      coverImgInput.value = url;
      coverPreview.src = url;
      coverUploading.style.display = 'none';
      (window as any).toast?.success('Imagen subida correctamente.');
    } catch {
      coverImgInput.value = '';
      coverUploading.style.display = 'none';
      (window as any).toast?.error('Error al subir la imagen.');
    }
  });

  btnRemoveCover.addEventListener('click', (e) => {
    e.stopPropagation();
    coverImgInput.value = '';
    coverPreview.style.display = 'none';
    coverPlaceholder.style.display = 'flex';
    btnRemoveCover.style.display = 'none';
    coverFile.value = '';
  });

  // Submit
  async function submitPost(status: 'DRAFT' | 'PUBLISHED') {
    const title    = (document.getElementById('title') as HTMLInputElement).value.trim();
    const excerpt  = (document.getElementById('excerpt') as HTMLTextAreaElement).value.trim();
    const content  = quillInstance ? quillInstance.root.innerHTML.trim() : '';
    const coverImg = (document.getElementById('coverImg') as HTMLInputElement).value || undefined;

    if (!title || !excerpt || !content || content === '<p><br></p>') {
      (window as any).toast?.error('Completa título, resumen y contenido.');
      return;
    }

    const buttons = document.querySelectorAll('.btn-draft, .btn-publish') as NodeListOf<HTMLButtonElement>;
    buttons.forEach(b => b.disabled = true);

    try {
      const res = await fetch(`${API}/blog`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, excerpt, content, coverImg, status }),
      });
      if (!res.ok) throw new Error();
      (window as any).toast?.success(status === 'PUBLISHED' ? 'Post publicado.' : 'Borrador guardado.');
      setTimeout(() => { window.location.href = '/admin/blog'; }, 800);
    } catch {
      (window as any).toast?.error('Error al guardar el post.');
      buttons.forEach(b => b.disabled = false);
    }
  }

  document.getElementById('btnDraft')?.addEventListener('click', () => submitPost('DRAFT'));
  document.getElementById('btnPublish')?.addEventListener('click', () => submitPost('PUBLISHED'));
</script>
