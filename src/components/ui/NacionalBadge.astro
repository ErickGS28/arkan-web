---
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<div class:list={['badge', variant]}>
  <img src="/banderamx.png" alt="México" class="flag" />
  <span class="text">Distribución Nacional</span>
</div>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    margin-bottom: 32px;
  }
  .badge.light {
    background: #F0F0F0;
    border: 1px solid #E0E0E0;
  }
  .badge.dark {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid #2A2A2A;
  }
  .flag { height: 28px; width: auto; object-fit: contain; flex-shrink: 0; }
  .text {
    font-family: 'Syne', sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .badge.light .text { color: #0A0A0A; }
  .badge.dark .text { color: #888; }
</style>
