---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const navItems = [
  { href: '/admin', label: 'Dashboard', group: 'general' },
  { href: '/admin/blog', label: 'Blog', group: 'contenido' },
  { href: '/admin/encuestas', label: 'Encuestas', group: 'contenido' },
  { href: '/admin/aruba', label: 'Aruba Jeans', group: 'marcas', logo: '/logos/aruba.jpg' },
  { href: '/admin/bakari', label: 'BKR Bakari', group: 'marcas', logo: '/logos/bakari.jpg' },
  { href: '/admin/black-bash', label: 'Black Bash MX', group: 'marcas', logo: '/logos/black-bash.jpg' },
];

const general  = navItems.filter(i => i.group === 'general');
const contenido = navItems.filter(i => i.group === 'contenido');
const marcas   = navItems.filter(i => i.group === 'marcas');
---

<style>
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: 220px;
    background: #080808;
    border-right: 1px solid #161616;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    z-index: 50;
  }

  /* Brand */
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 24px 20px 20px;
    border-bottom: 1px solid #141414;
  }
  .brand-logo {
    width: 28px; height: 28px;
    object-fit: contain;
    opacity: 0.7;
    border-radius: 2px;
  }
  .brand-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 14px;
    letter-spacing: 3px;
    color: #888;
  }

  /* User section */
  .sidebar-user {
    padding: 20px 20px 16px;
    border-bottom: 1px solid #111;
  }
  .user-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 17px;
    letter-spacing: 2px;
    color: #DDDDDD;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .role-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border: 1px solid #222;
    font-family: 'Syne', sans-serif;
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #555;
  }
  .role-chip.gerente {
    border-color: #444;
    color: #CCCCCC;
  }
  .role-dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #333;
    flex-shrink: 0;
  }
  .role-chip.gerente .role-dot { background: #AAAAAA; }

  /* Nav */
  .sidebar-nav {
    flex: 1;
    padding: 12px 0;
  }
  .nav-group {
    margin-bottom: 4px;
  }
  .nav-group-label {
    padding: 12px 20px 6px;
    font-family: 'Syne', sans-serif;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #2E2E2E;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    letter-spacing: 0.5px;
    color: #555;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    border-left: 2px solid transparent;
  }
  .nav-item:hover {
    color: #CCCCCC;
    background: #0F0F0F;
  }
  .nav-item.active {
    color: #F0F0F0;
    border-left-color: #F0F0F0;
    background: #0F0F0F;
  }
  .nav-item svg {
    width: 14px; height: 14px;
    flex-shrink: 0;
    opacity: 0.6;
  }
  .nav-item.active svg { opacity: 1; }
  .nav-brand-logo {
    width: 16px; height: 16px;
    object-fit: contain;
    border-radius: 2px;
    opacity: 0.5;
    flex-shrink: 0;
  }
  .nav-item.active .nav-brand-logo,
  .nav-item:hover .nav-brand-logo { opacity: 0.85; }

  /* Logout */
  .sidebar-footer {
    padding: 16px 20px;
    border-top: 1px solid #111;
  }
  .btn-logout {
    width: 100%;
    padding: 9px 14px;
    background: transparent;
    border: 1px solid #1C1C1C;
    color: #444;
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
    text-align: center;
  }
  .btn-logout:hover {
    border-color: #444;
    color: #CCCCCC;
  }
</style>

<aside class="sidebar">
  <!-- Brand -->
  <div class="sidebar-brand">
    <img src="/logos/arkan.jpg" alt="Arkán" class="brand-logo" />
    <span class="brand-name">ARKÁN ADMIN</span>
  </div>

  <!-- User -->
  <div class="sidebar-user">
    <p class="user-name" id="sidebarUserName">—</p>
    <span class="role-chip" id="sidebarRoleChip">
      <span class="role-dot" id="sidebarRoleDot"></span>
      <span id="sidebarRoleLabel">—</span>
    </span>
  </div>

  <!-- Nav -->
  <nav class="sidebar-nav">

    <!-- General -->
    <div class="nav-group">
      {general.map(item => (
        <a
          href={item.href}
          class:list={['nav-item', { active: currentPath === item.href }]}
        >
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1"/>
            <rect x="9" y="1.5" width="5.5" height="5.5" rx="1"/>
            <rect x="1.5" y="9" width="5.5" height="5.5" rx="1"/>
            <rect x="9" y="9" width="5.5" height="5.5" rx="1"/>
          </svg>
          {item.label}
        </a>
      ))}
    </div>

    <!-- Contenido -->
    <div class="nav-group">
      <p class="nav-group-label">Contenido</p>
      {contenido.map(item => (
        <a
          href={item.href}
          class:list={['nav-item', { active: currentPath === item.href }]}
        >
          {item.label === 'Blog' ? (
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <rect x="2" y="1.5" width="10" height="13" rx="1"/>
              <line x1="4.5" y1="5" x2="9.5" y2="5"/>
              <line x1="4.5" y1="7.5" x2="9.5" y2="7.5"/>
              <line x1="4.5" y1="10" x2="7.5" y2="10"/>
            </svg>
          ) : (
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <line x1="1.5" y1="14" x2="14.5" y2="14"/>
              <rect x="2.5" y="9" width="3" height="5" rx="0.5"/>
              <rect x="6.5" y="5.5" width="3" height="8.5" rx="0.5"/>
              <rect x="10.5" y="7" width="3" height="7" rx="0.5"/>
            </svg>
          )}
          {item.label}
        </a>
      ))}
    </div>

    <!-- Marcas -->
    <div class="nav-group">
      <p class="nav-group-label">Marcas</p>
      {marcas.map(item => (
        <a
          href={item.href}
          class:list={['nav-item', { active: currentPath === item.href }]}
        >
          <img src={item.logo} alt={item.label} class="nav-brand-logo" />
          {item.label}
        </a>
      ))}
    </div>

  </nav>

  <!-- Logout -->
  <div class="sidebar-footer">
    <button class="btn-logout" id="sidebarLogout">Cerrar sesión</button>
  </div>
</aside>
