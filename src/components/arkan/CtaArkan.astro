<style>
  .cta-final {
    background: #0A0A0A;
    padding: 140px 80px;
    text-align: center;
    border-top: 1px solid #1A1A1A;
    position: relative;
    overflow: hidden;
  }
  /* watermark decorativo */
  .cta-final::before {
    content: 'ARKÁN';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(120px, 18vw, 240px);
    letter-spacing: 12px;
    color: rgba(255,255,255,0.03);
    pointer-events: none;
    white-space: nowrap;
  }

  .cta-inner {
    position: relative; z-index: 1;
    max-width: 700px; margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center; gap: 24px;
  }

  .cta-eyebrow {
    font-family: 'Syne', sans-serif;
    font-size: 11px; letter-spacing: 5px; color: #444;
    text-transform: uppercase;
  }
  .cta-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(56px, 8vw, 112px);
    letter-spacing: 6px; color: #F0F0F0; line-height: 0.95;
  }
  .cta-body {
    font-family: 'Syne', sans-serif;
    font-size: 15px; line-height: 1.8; color: #555;
    max-width: 520px;
  }

  .cta-actions {
    display: flex; gap: 16px; margin-top: 16px;
    flex-wrap: wrap; justify-content: center;
  }

  .cta-btn-wa {
    display: inline-flex; align-items: center; gap: 10px;
    background: #25D366; color: #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; padding: 16px 32px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .cta-btn-wa:hover { background: #20BA58; transform: translateY(-2px); }

  .cta-btn-outline {
    display: inline-flex; align-items: center;
    background: transparent; color: #F0F0F0;
    font-family: 'Syne', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; padding: 16px 32px;
    border: 1px solid #2A2A2A;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }
  .cta-btn-outline:hover { border-color: #555; }

  @media (max-width: 768px) {
    .cta-final { padding: 100px 24px; }
    .cta-actions { flex-direction: column; width: 100%; }
    .cta-btn-wa, .cta-btn-outline { justify-content: center; width: 100%; }
  }
  @media (max-width: 480px) {
    .cta-final { padding: 80px 20px; }
    .cta-title { letter-spacing: 4px; }
  }
</style>
