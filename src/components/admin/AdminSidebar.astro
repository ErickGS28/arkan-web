---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const navItems = [
  { href: '/admin', label: 'Dashboard', group: 'general' },
  { href: '/admin/blog', label: 'Blog', group: 'contenido' },
  { href: '/admin/encuestas', label: 'Encuestas', group: 'contenido' },
  { href: '/admin/marcas/aruba', label: 'Aruba Jeans', group: 'marcas', logo: '/logos/aruba.jpg' },
  { href: '/admin/marcas/bakari', label: 'BKR Bakari', group: 'marcas', logo: '/logos/bakari.jpg' },
  { href: '/admin/marcas/black-bash', label: 'Black Bash MX', group: 'marcas', logo: '/logos/black-bash.jpg' },
];

const general   = navItems.filter(i => i.group === 'general');
const contenido = navItems.filter(i => i.group === 'contenido');
const marcas    = navItems.filter(i => i.group === 'marcas');
---

<style>
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: 260px;
    background: #060606;
    border-right: 1px solid #141414;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    z-index: 50;
    scrollbar-width: none;
  }
  .sidebar::-webkit-scrollbar { display: none; }

  /* Brand */
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 28px 24px 24px;
    border-bottom: 1px solid #111;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 30px; height: 30px;
    object-fit: contain;
    border-radius: 3px;
    opacity: 0.92;
  }
  .brand-text {}
  .brand-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 14px;
    letter-spacing: 3.5px;
    color: #CCCCCC;
    line-height: 1;
    display: block;
  }
  .brand-sub {
    font-family: 'Syne', sans-serif;
    font-size: 9px;
    letter-spacing: 2px;
    color: #3A3A3A;
    text-transform: uppercase;
    margin-top: 3px;
    display: block;
  }

  /* User section */
  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 24px;
    border-bottom: 1px solid #111;
    flex-shrink: 0;
  }
  .user-avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: #1E1E1E;
    border: 1px solid #2A2A2A;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 1px;
    color: #888;
    flex-shrink: 0;
  }
  .user-info { overflow: hidden; }
  .user-name {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #DDDDDD;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }
  .role-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 5px;
    padding: 2px 8px;
    border: 1px solid #222;
    font-family: 'Syne', sans-serif;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #444;
    border-radius: 2px;
  }
  .role-chip.gerente {
    border-color: #2A2A2A;
    color: #AAAAAA;
    background: #111;
  }
  .role-dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #333;
    flex-shrink: 0;
  }
  .role-chip.gerente .role-dot { background: #888; }

  /* Nav */
  .sidebar-nav {
    flex: 1;
    padding: 16px 0 8px;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .sidebar-nav::-webkit-scrollbar { display: none; }

  .nav-group { margin-bottom: 2px; }

  .nav-group-label {
    padding: 14px 24px 6px;
    font-family: 'Syne', sans-serif;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #333;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 11px 24px;
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2px;
    color: #666;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
    border-left: 2px solid transparent;
    position: relative;
  }
  .nav-item:hover {
    color: #CCCCCC;
    background: #0D0D0D;
    border-left-color: #2A2A2A;
  }
  .nav-item.active {
    color: #EEEEEE;
    background: #111;
    border-left-color: #FFFFFF;
  }
  .nav-item svg {
    width: 15px; height: 15px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.15s;
  }
  .nav-item:hover svg  { opacity: 0.8; }
  .nav-item.active svg { opacity: 1; }

  .nav-brand-logo {
    width: 17px; height: 17px;
    object-fit: contain;
    border-radius: 2px;
    opacity: 0.5;
    flex-shrink: 0;
    transition: opacity 0.15s;
  }
  .nav-item:hover  .nav-brand-logo { opacity: 0.8; }
  .nav-item.active .nav-brand-logo { opacity: 1; }

  .nav-divider {
    height: 1px;
    background: #111;
    margin: 8px 24px;
  }

  /* Logout */
  .sidebar-footer {
    padding: 16px 24px 24px;
    border-top: 1px solid #111;
    flex-shrink: 0;
  }
  .btn-logout {
    width: 100%;
    padding: 10px 16px;
    background: transparent;
    border: 1px solid #1E1E1E;
    color: #444;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    border-radius: 2px;
  }
  .btn-logout:hover {
    background: #111;
    border-color: #333;
    color: #BBBBBB;
  }
</style>

<aside class="sidebar">
  <!-- Brand -->
  <div class="sidebar-brand">
    <img src="/logos/arkan.jpg" alt="Arkán" class="brand-logo" />
    <div class="brand-text">
      <span class="brand-name">ARKÁN</span>
      <span class="brand-sub">Panel Admin</span>
    </div>
  </div>

  <!-- User -->
  <div class="sidebar-user">
    <div class="user-avatar" id="sidebarAvatar">A</div>
    <div class="user-info">
      <span class="user-name" id="sidebarUserName">—</span>
      <span class="role-chip" id="sidebarRoleChip">
        <span class="role-dot"></span>
        <span id="sidebarRoleLabel">—</span>
      </span>
    </div>
  </div>

  <!-- Nav -->
  <nav class="sidebar-nav">

    <!-- General -->
    <div class="nav-group">
      {general.map(item => (
        <a href={item.href} class:list={['nav-item', { active: currentPath === item.href }]}>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <rect x="1.5" y="1.5" width="5" height="5" rx="1"/>
            <rect x="9.5" y="1.5" width="5" height="5" rx="1"/>
            <rect x="1.5" y="9.5" width="5" height="5" rx="1"/>
            <rect x="9.5" y="9.5" width="5" height="5" rx="1"/>
          </svg>
          {item.label}
        </a>
      ))}
    </div>

    <div class="nav-divider"></div>

    <!-- Contenido -->
    <div class="nav-group">
      <p class="nav-group-label">Contenido</p>
      {contenido.map(item => (
        <a
          href={item.href}
          class:list={['nav-item', { active: currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href)) }]}
        >
          {item.label === 'Blog' ? (
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <rect x="2" y="1.5" width="12" height="13" rx="1.5"/>
              <line x1="4.5" y1="5.5" x2="11.5" y2="5.5"/>
              <line x1="4.5" y1="8" x2="11.5" y2="8"/>
              <line x1="4.5" y1="10.5" x2="8.5" y2="10.5"/>
            </svg>
          ) : (
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M2 13.5h12"/>
              <rect x="2.5" y="8.5" width="3" height="5" rx="0.5"/>
              <rect x="6.5" y="5" width="3" height="8.5" rx="0.5"/>
              <rect x="10.5" y="6.5" width="3" height="7" rx="0.5"/>
            </svg>
          )}
          {item.label}
        </a>
      ))}
    </div>

    <div class="nav-divider"></div>

    <!-- Marcas -->
    <div class="nav-group">
      <p class="nav-group-label">Marcas</p>
      {marcas.map(item => (
        <a
          href={item.href}
          class:list={['nav-item', { active: currentPath === item.href || currentPath.startsWith(item.href) }]}
        >
          <img src={item.logo} alt={item.label} class="nav-brand-logo" />
          {item.label}
        </a>
      ))}
    </div>

  </nav>

  <!-- Logout -->
  <div class="sidebar-footer">
    <button class="btn-logout" id="sidebarLogout">Cerrar sesión</button>
  </div>
</aside>
