---
import Layout from '../../layouts/Layout.astro';
import NavArkan from '../../components/arkan/NavArkan.astro';
import FooterArkan from '../../components/arkan/FooterArkan.astro';
---

<Layout title="Blog — Arkán Group" description="Artículos sobre denim, moda y distribución mayorista en México.">
  <NavArkan />

  <main class="blog-main">
    <header class="blog-header">
      <p class="blog-eyebrow">Arkán Group</p>
      <h1 class="blog-title">BLOG</h1>
      <p class="blog-sub">Denim, moda y cómo construir un negocio real.</p>
    </header>

    <section class="post-list" id="postList">
      <div class="skeleton-wrap">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
      </div>
    </section>
  </main>

  <FooterArkan />
</Layout>

<style>
  .blog-main { padding-top: 64px; background: #FFFFFF; min-height: 100vh; }

  /* Header */
  .blog-header {
    background: #0A0A0A;
    padding: 100px 80px 80px;
    text-align: center;
  }
  .blog-eyebrow {
    font-family: 'Syne', sans-serif;
    font-size: 11px; letter-spacing: 5px; color: #555;
    text-transform: uppercase; margin-bottom: 16px;
  }
  .blog-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 10vw, 120px);
    letter-spacing: 8px; color: #F0F0F0; line-height: 1;
    margin-bottom: 20px;
  }
  .blog-sub {
    font-family: 'Syne', sans-serif;
    font-size: 15px; color: #555; letter-spacing: 1px;
  }

  /* Lista de artículos */
  .post-list {
    max-width: 1000px;
    margin: 0 auto;
    padding: 64px 48px;
    display: flex;
    flex-direction: column;
  }

  /* Skeleton */
  .skeleton-wrap { display: flex; flex-direction: column; gap: 0; }
  .skeleton-card {
    height: 190px;
    background: linear-gradient(90deg, #F5F5F5 25%, #EEEEEE 50%, #F5F5F5 75%);
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
    border-bottom: 1px solid #E8E8E8;
    margin-bottom: 0;
    padding: 40px 0;
    box-sizing: content-box;
  }
  @keyframes shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 80px 0;
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    color: #AAA;
    letter-spacing: 1px;
  }

  .post-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 0;
    text-decoration: none;
    border-bottom: 1px solid #E8E8E8;
    padding: 40px 0;
  }
  .post-card:first-child { border-top: 1px solid #E8E8E8; }

  /* Imagen */
  .post-image {
    flex: 0 0 280px;
    height: 190px;
    overflow: hidden;
    align-self: center;
    background: #F0F0F0;
  }
  .post-image img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s ease, filter 0.4s ease;
    filter: grayscale(15%);
  }
  .post-card:hover .post-image img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  /* Contenido */
  .post-body {
    flex: 1;
    padding: 0 0 0 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .post-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px; color: #E0E0E0; line-height: 1;
  }
  .post-sep { color: #D0D0D0; font-size: 12px; }
  .post-date, .post-read {
    font-family: 'Syne', sans-serif;
    font-size: 11px; letter-spacing: 2px;
    color: #AAA; text-transform: uppercase;
  }

  .post-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(22px, 2.4vw, 32px);
    letter-spacing: 1.5px; color: #0A0A0A;
    line-height: 1.05;
    transition: color 0.2s ease;
  }
  .post-card:hover .post-title { color: #333; }

  .post-excerpt {
    font-family: 'Syne', sans-serif;
    font-size: 13px; line-height: 1.8; color: #777;
  }

  .post-link {
    font-family: 'Syne', sans-serif;
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; color: #0A0A0A;
    text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 6px;
    transition: gap 0.2s ease;
    margin-top: 4px;
  }
  .post-card:hover .post-link { gap: 12px; }

  @media (max-width: 768px) {
    .blog-header { padding: 80px 24px 60px; }
    .post-list { padding: 48px 24px; }
  }
  @media (max-width: 600px) {
    .post-list { padding: 32px 20px; }
    .post-card { flex-direction: column; gap: 16px; padding: 28px 0; }
    .post-image { flex: none; width: 100%; height: 200px; }
    .post-body { padding: 0; }
    .post-title { font-size: clamp(20px, 6vw, 28px); }
  }
</style>

<script>
  const API = 'http://localhost:4013';

  function formatDate(iso: string | null): string {
    if (!iso) return '';
    return new Date(iso).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
  }

  async function loadPosts() {
    const list = document.getElementById('postList')!;
    try {
      const res = await fetch(`${API}/blog`);
      if (!res.ok) throw new Error();
      const posts: any[] = await res.json();

      if (!posts.length) {
        list.innerHTML = '<div class="empty-state">Aún no hay artículos publicados.</div>';
        return;
      }

      list.innerHTML = posts.map((post, i) => `
        <a href="/blog/${post.slug}" class="post-card">
          <div class="post-image">
            ${post.coverImg ? `<img src="${post.coverImg}" alt="${post.title}" loading="${i === 0 ? 'eager' : 'lazy'}" />` : ''}
          </div>
          <div class="post-body">
            <div class="post-meta">
              <span class="post-num">${String(i + 1).padStart(2, '0')}</span>
              <span class="post-sep">/</span>
              <span class="post-date">${formatDate(post.publishedAt)}</span>
              <span class="post-sep">·</span>
              <span class="post-read">${post.readTime} lectura</span>
            </div>
            <h2 class="post-title">${post.title}</h2>
            <p class="post-excerpt">${post.excerpt}</p>
            <span class="post-link">Leer artículo →</span>
          </div>
        </a>
      `).join('');
    } catch {
      list.innerHTML = '<div class="empty-state">No se pudieron cargar los artículos.</div>';
    }
  }

  loadPosts();
</script>
