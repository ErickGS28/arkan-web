---
import Layout from '../../layouts/Layout.astro';
import NavArkan from '../../components/arkan/NavArkan.astro';
import FooterArkan from '../../components/arkan/FooterArkan.astro';

const { slug } = Astro.params;
---

<Layout title="Encuesta — Arkán Group" description="">
  <NavArkan />

  <main class="survey-main">
    <div id="loadingState" class="state-center">
      <div class="loading-inner"><div class="loading-bar"></div></div>
    </div>

    <div id="alreadyAnswered" class="state-center" style="display:none">
      <p class="state-icon">✓</p>
      <p class="state-title">Ya respondiste esta encuesta</p>
      <p class="state-sub">Gracias por tu participación.</p>
    </div>

    <div id="closedState" class="state-center" style="display:none">
      <p class="state-title">Esta encuesta ya no está disponible</p>
      <a href="/" class="state-link">← Volver al inicio</a>
    </div>

    <div id="successState" class="state-center" style="display:none">
      <p class="state-icon">✓</p>
      <p class="state-title">¡Gracias por tu respuesta!</p>
      <p class="state-sub">Tu opinión nos ayuda a mejorar.</p>
    </div>

    <div id="surveyWrap" style="display:none">
      <header class="survey-header">
        <p class="survey-eyebrow">Arkán Group</p>
        <h1 class="survey-title" id="surveyTitle"></h1>
        <p class="survey-desc" id="surveyDesc"></p>
      </header>

      <form class="survey-form" id="surveyForm">
        <div id="questionsWrap"></div>
        <div class="submit-row">
          <button type="submit" class="btn-submit">Enviar respuestas</button>
        </div>
      </form>
    </div>
  </main>

  <FooterArkan />
</Layout>

<style is:global>
  .survey-main {
    padding-top: 64px;
    min-height: 100vh;
    background: #F5F5F5;
  }

  /* States */
  .state-center {
    min-height: calc(100vh - 64px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 16px; padding: 40px 20px; text-align: center;
  }
  .state-icon { font-size: 48px; color: #0A0A0A; }
  .state-title { font-family: 'Bebas Neue', sans-serif; font-size: 32px; letter-spacing: 3px; color: #0A0A0A; }
  .state-sub { font-family: 'Syne', sans-serif; font-size: 14px; color: #777; }
  .state-link { font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #0A0A0A; }

  /* Loading bar */
  .loading-inner { width: 120px; height: 2px; background: #DDD; overflow: hidden; }
  .loading-bar { height: 100%; background: #0A0A0A; animation: loadBar 1.2s ease-in-out infinite; }
  @keyframes loadBar { 0% { width:0;margin-left:0; } 50% { width:60%;margin-left:20%; } 100% { width:0;margin-left:100%; } }

  /* Header */
  .survey-header {
    background: #0A0A0A;
    padding: 80px 40px 60px;
    text-align: center;
  }
  .survey-eyebrow { font-family: 'Syne', sans-serif; font-size: 11px; letter-spacing: 5px; color: #555; text-transform: uppercase; margin-bottom: 16px; }
  .survey-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(36px, 6vw, 72px); letter-spacing: 4px; color: #F0F0F0; line-height: 1; margin-bottom: 16px; }
  .survey-desc { font-family: 'Syne', sans-serif; font-size: 15px; color: #666; max-width: 560px; margin: 0 auto; line-height: 1.7; }

  /* Form */
  .survey-form { max-width: 680px; margin: 0 auto; padding: 48px 20px 80px; }

  /* Question card */
  .q-block { background: #FFF; border: 1px solid #E8E8E8; padding: 32px; margin-bottom: 16px; color: #0A0A0A; }
  .q-block-title { font-family: 'Syne', sans-serif; font-size: 16px; font-weight: 700; color: #0A0A0A; margin-bottom: 6px; line-height: 1.4; }
  .q-required-mark { color: #D33; margin-left: 2px; }
  .q-type-hint { font-family: 'Syne', sans-serif; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: #AAA; margin-bottom: 20px; }

  /* Options */
  .option-item { display: flex; align-items: center; gap: 12px; padding: 12px 16px; margin-bottom: 8px; border: 1px solid #EBEBEB; cursor: pointer; transition: border-color 0.15s, background 0.15s; }
  .option-item:hover { border-color: #0A0A0A; background: #FAFAFA; }
  .option-item.selected { border-color: #0A0A0A; background: #F0F0F0; }
  .option-item input[type="radio"], .option-item input[type="checkbox"] { accent-color: #0A0A0A; width: 16px; height: 16px; flex-shrink: 0; }
  .option-label { font-family: 'Syne', sans-serif; font-size: 14px; color: #222; line-height: 1.4; }

  /* Text answer */
  .text-answer-input {
    width: 100%; padding: 14px 16px; border: 1px solid #DCDCDC; background: #FAFAFA;
    font-family: 'Syne', sans-serif; font-size: 14px; color: #111; outline: none;
    resize: vertical; min-height: 100px; transition: border-color 0.15s;
  }
  .text-answer-input:focus { border-color: #0A0A0A; background: #FFF; }

  /* Submit */
  .submit-row { margin-top: 32px; text-align: center; }
  .btn-submit {
    padding: 16px 48px; background: #0A0A0A; color: #FFF; border: none;
    font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase; cursor: pointer;
    transition: background 0.2s;
  }
  .btn-submit:hover { background: #333; }
  .btn-submit:disabled { opacity: 0.4; cursor: not-allowed; }
</style>

<script define:vars={{ slug }}>
  const API = 'https://api.arkangroup.mx';
  const STORAGE_KEY = `arkan_survey_${slug}`;

  // Check if already answered
  if (localStorage.getItem(STORAGE_KEY)) {
    document.getElementById('loadingState').style.display = 'none';
    document.getElementById('alreadyAnswered').style.display = 'flex';
  } else {
    loadSurvey();
  }

  async function loadSurvey() {
    try {
      const res = await fetch(`${API}/surveys/public/${slug}`);
      if (!res.ok) throw new Error('not found');
      const json = await res.json();
      const survey = json?.data ?? json;

      document.title = `${survey.title} — Arkán Group`;
      document.getElementById('surveyTitle').textContent = survey.title;
      document.getElementById('surveyDesc').textContent = survey.description ?? '';

      const wrap = document.getElementById('questionsWrap');
      const sorted = [...(survey.questions ?? [])].sort((a, b) => a.order - b.order);

      wrap.innerHTML = sorted.map((q, qi) => {
        const typeHint = q.type === 'SINGLE' ? 'Elige una opción' : q.type === 'MULTIPLE' ? 'Puedes elegir varias' : 'Respuesta abierta';
        const reqMark = q.required ? '<span class="q-required-mark">*</span>' : '';

        let controls = '';
        if (q.type === 'TEXT') {
          controls = `<textarea class="text-answer-input" data-qid="${q.id}" placeholder="Escribe tu respuesta..."></textarea>`;
        } else {
          const inputType = q.type === 'SINGLE' ? 'radio' : 'checkbox';
          const opts = [...(q.options ?? [])].sort((a, b) => a.order - b.order);
          controls = opts.map(opt => `
            <label class="option-item" data-qid="${q.id}" data-oid="${opt.id}">
              <input type="${inputType}" name="q_${q.id}" value="${opt.id}" />
              <span class="option-label">${opt.text}</span>
            </label>
          `).join('');
        }

        return `
          <div class="q-block" data-qid="${q.id}" data-type="${q.type}" data-required="${q.required}">
            <p class="q-block-title">${String(qi + 1).padStart(2, '0')}. ${q.text}${reqMark}</p>
            <p class="q-type-hint">${typeHint}</p>
            ${controls}
          </div>`;
      }).join('');

      // Option item visual selection toggle
      wrap.querySelectorAll('.option-item').forEach(label => {
        const input = label.querySelector('input');
        const qid = label.dataset.qid;

        input.addEventListener('change', () => {
          if (input.type === 'radio') {
            wrap.querySelectorAll(`.option-item[data-qid="${qid}"]`).forEach(l => l.classList.remove('selected'));
          }
          label.classList.toggle('selected', input.checked);
        });
      });

      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('surveyWrap').style.display = 'block';

      document.getElementById('surveyForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        await submitSurvey(survey);
      });

    } catch {
      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('closedState').style.display = 'flex';
    }
  }

  async function submitSurvey(survey) {
    const token = crypto.randomUUID();
    const answers = [];

    for (const q of survey.questions) {
      if (q.type === 'TEXT') {
        const ta = document.querySelector(`.text-answer-input[data-qid="${q.id}"]`);
        const val = ta?.value.trim() ?? '';
        if (q.required && !val) {
          alert(`Por favor responde: "${q.text}"`);
          ta?.focus();
          return;
        }
        if (val) answers.push({ questionId: q.id, textValue: val });
      } else {
        const checked = [...document.querySelectorAll(`input[name="q_${q.id}"]:checked`)].map(i => Number(i.value));
        if (q.required && !checked.length) {
          alert(`Por favor selecciona una opción en: "${q.text}"`);
          return;
        }
        if (checked.length) answers.push({ questionId: q.id, optionIds: checked });
      }
    }

    const btn = document.querySelector('.btn-submit');
    btn.disabled = true;

    try {
      const res = await fetch(`${API}/surveys/public/${slug}/submit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token, answers }),
      });
      if (!res.ok) throw new Error();
      localStorage.setItem(STORAGE_KEY, '1');
      document.getElementById('surveyWrap').style.display = 'none';
      document.getElementById('successState').style.display = 'flex';
    } catch {
      alert('Error al enviar. Por favor intenta de nuevo.');
      btn.disabled = false;
    }
  }
</script>
