---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Categoría — Imágenes">
  <div class="page">
    <a class="btn-back" id="backLink" href="/admin">← Volver</a>

    <header class="page-header">
      <div>
        <p class="page-brand" id="pageBrand">—</p>
        <h1 class="page-title" id="pageTitle">Cargando...</h1>
        <p class="page-desc" id="pageDesc"></p>
      </div>
      <label class="btn-upload" for="fileInput">
        + Subir imagen
        <input type="file" id="fileInput" accept="image/*" style="display:none" />
      </label>
    </header>

    <div id="uploadProgress" class="upload-progress" style="display:none">
      <div class="upload-bar"><div class="upload-bar-fill" id="uploadBarFill"></div></div>
      <p class="upload-text" id="uploadText">Subiendo...</p>
    </div>

    <div class="images-grid" id="imagesGrid">
      <p class="loading-msg">Cargando imágenes...</p>
    </div>
  </div>

  <!-- Delete image confirm modal -->
  <div class="modal-overlay" id="deleteModal">
    <div class="modal">
      <h2 class="modal-title">Eliminar imagen</h2>
      <p class="delete-msg">¿Eliminar esta imagen? Se borrará de Cloudflare R2 y no podrá recuperarse.</p>
      <div class="modal-actions">
        <button class="btn-cancel" id="btnCancelDel">Cancelar</button>
        <button class="btn-delete-confirm" id="btnConfirmDel">Eliminar</button>
      </div>
    </div>
  </div>
</AdminLayout>

<style is:global>
  .page { padding: 40px 48px; max-width: 1200px; }

  .btn-back {
    display: inline-block;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #999;
    text-decoration: none;
    margin-bottom: 28px;
    transition: color 0.15s;
  }
  .btn-back:hover { color: #0A0A0A; }

  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 32px;
    gap: 16px;
  }
  .page-brand {
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #AAAAAA;
    margin: 0 0 4px;
  }
  .page-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 42px;
    letter-spacing: 3px;
    color: #0A0A0A;
    margin: 0 0 6px;
  }
  .page-desc {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    color: #888;
    margin: 0;
    max-width: 480px;
  }

  .btn-upload {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: #0A0A0A;
    color: #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .btn-upload:hover { background: #333; }

  .upload-progress {
    margin-bottom: 24px;
    background: #FFFFFF;
    border: 1px solid #EBEBEB;
    padding: 16px;
  }
  .upload-bar {
    width: 100%;
    height: 3px;
    background: #EBEBEB;
    margin-bottom: 10px;
  }
  .upload-bar-fill {
    height: 100%;
    background: #0A0A0A;
    width: 0%;
    transition: width 0.3s ease;
  }
  .upload-text {
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    color: #888;
    margin: 0;
  }

  .images-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .image-card {
    position: relative;
    aspect-ratio: 3 / 4;
    background: #F0F0F0;
    border: 1px solid #E8E8E8;
    overflow: hidden;
  }
  .image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .image-card:hover img { transform: scale(1.04); }
  .image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .image-card:hover .image-overlay { opacity: 1; }
  .btn-del-img {
    padding: 8px 16px;
    background: #CC2222;
    color: #FFFFFF;
    font-family: 'Syne', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-del-img:hover { background: #AA1A1A; }

  .loading-msg {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    color: #999;
    grid-column: 1/-1;
    text-align: center;
    padding: 48px 0;
  }

  /* Modal */
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 200;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: #FFFFFF;
    border: 1px solid #E8E8E8;
    padding: 32px;
    width: 100%;
    max-width: 380px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.12);
  }
  .modal-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px;
    letter-spacing: 3px;
    color: #0A0A0A;
    margin: 0 0 16px;
  }
  .modal-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
  }
  .btn-cancel {
    padding: 10px 20px;
    background: transparent;
    border: 1px solid #D8D8D8;
    color: #666;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .btn-cancel:hover { color: #222; border-color: #999; }
  .btn-delete-confirm {
    padding: 10px 20px;
    background: #CC2222;
    color: #FFFFFF;
    border: none;
    font-family: 'Syne', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.15s;
  }
  .btn-delete-confirm:hover { background: #AA1A1A; }
  .delete-msg {
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    color: #555;
    line-height: 1.6;
    margin: 0 0 24px;
  }
</style>

<script>
  const API = 'https://api.arkangroup.mx';
  const params = new URLSearchParams(window.location.search);
  const categoryId = params.get('id');
  const brandSlug = params.get('brand') ?? 'aruba';

  const BRAND_NAMES: Record<string, string> = {
    aruba: 'Aruba Jeans',
    bakari: 'BKR Bakari',
    'black-bash': 'Black Bash MX',
  };

  let deleteTargetId: number | null = null;

  if (!categoryId) window.location.href = '/admin';

  (document.getElementById('backLink') as HTMLAnchorElement).href = `/admin/marcas/${brandSlug}`;

  async function loadCategory() {
    try {
      const res = await fetch(`${API}/brands/categories/${categoryId}`, { credentials: 'include' });
      const json = await res.json();
      const category = json?.data ?? json;

      (document.getElementById('pageBrand') as HTMLElement).textContent = BRAND_NAMES[brandSlug] ?? brandSlug;
      (document.getElementById('pageTitle') as HTMLElement).textContent = category.name;
      (document.getElementById('pageDesc') as HTMLElement).textContent = category.description ?? '';

      renderImages(category.images ?? []);
    } catch {
      (document.getElementById('pageTitle') as HTMLElement).textContent = 'Error al cargar';
    }
  }

  function renderImages(images: any[]) {
    const grid = document.getElementById('imagesGrid') as HTMLElement;
    if (!images.length) {
      grid.innerHTML = '<p class="loading-msg">Sin imágenes. Sube la primera.</p>';
      return;
    }
    grid.innerHTML = images
      .sort((a: any, b: any) => (a.order ?? 0) - (b.order ?? 0))
      .map((img: any) => `
        <div class="image-card">
          <img src="${img.url}" alt="${img.alt ?? ''}" loading="lazy" />
          <div class="image-overlay">
            <button class="btn-del-img" data-id="${img.id}">Eliminar</button>
          </div>
        </div>
      `)
      .join('');

    grid.querySelectorAll<HTMLButtonElement>('.btn-del-img').forEach(btn => {
      btn.addEventListener('click', () => openDeleteModal(Number(btn.dataset.id)));
    });
  }

  (document.getElementById('fileInput') as HTMLInputElement).addEventListener('change', async e => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;

    const progress = document.getElementById('uploadProgress') as HTMLElement;
    const fill = document.getElementById('uploadBarFill') as HTMLElement;
    const text = document.getElementById('uploadText') as HTMLElement;

    progress.style.display = 'block';
    fill.style.width = '30%';
    text.textContent = 'Subiendo...';

    const formData = new FormData();
    formData.append('file', file);

    try {
      fill.style.width = '60%';
      const res = await fetch(`${API}/brands/categories/${categoryId}/images`, {
        method: 'POST',
        credentials: 'include',
        body: formData,
      });
      fill.style.width = '100%';

      if (!res.ok) {
        (window as any).toast?.error('No se pudo subir la imagen. Intenta de nuevo.');
        setTimeout(() => { progress.style.display = 'none'; fill.style.width = '0%'; }, 600);
        return;
      }

      input.value = '';
      await loadCategory();
      (window as any).toast?.success('Imagen subida correctamente.');
      setTimeout(() => { progress.style.display = 'none'; fill.style.width = '0%'; }, 500);
    } catch {
      (window as any).toast?.error('Error de conexión al subir la imagen.');
      setTimeout(() => { progress.style.display = 'none'; fill.style.width = '0%'; }, 600);
    }
  });

  function openDeleteModal(imageId: number) {
    deleteTargetId = imageId;
    (document.getElementById('deleteModal') as HTMLElement).classList.add('open');
  }

  (document.getElementById('btnCancelDel') as HTMLElement).addEventListener('click', () => {
    (document.getElementById('deleteModal') as HTMLElement).classList.remove('open');
    deleteTargetId = null;
  });

  (document.getElementById('btnConfirmDel') as HTMLElement).addEventListener('click', async () => {
    if (!deleteTargetId) return;
    const btn = document.getElementById('btnConfirmDel') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Eliminando...';
    try {
      const res = await fetch(`${API}/brands/images/${deleteTargetId}`, { method: 'DELETE', credentials: 'include' });
      if (!res.ok) throw new Error();
      (document.getElementById('deleteModal') as HTMLElement).classList.remove('open');
      deleteTargetId = null;
      await loadCategory();
      (window as any).toast?.success('Imagen eliminada.');
    } catch {
      (window as any).toast?.error('No se pudo eliminar la imagen.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Eliminar';
    }
  });

  (document.getElementById('deleteModal') as HTMLElement).addEventListener('click', e => {
    if (e.target === e.currentTarget) {
      (e.currentTarget as HTMLElement).classList.remove('open');
      deleteTargetId = null;
    }
  });

  document.addEventListener('arkan:auth-ready', loadCategory);
</script>
