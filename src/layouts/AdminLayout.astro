---
import AdminSidebar from '../components/admin/AdminSidebar.astro';

interface Props {
  title?: string;
}
const { title = 'Admin' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Arkán Admin</title>
  <link rel="icon" type="image/jpeg" href="/logos/arkan.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Syne:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: 'Syne', sans-serif;
      -webkit-font-smoothing: antialiased;
      background: #F6F6F6;
    }

    .admin-shell {
      display: flex;
      min-height: 100vh;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .admin-shell.ready { opacity: 1; }

    /* Loading state */
    .admin-loading {
      position: fixed;
      inset: 0;
      background: #080808;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 200;
      font-family: 'Syne', sans-serif;
      font-size: 10px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: #2A2A2A;
      transition: opacity 0.3s ease;
    }
    .admin-loading.hidden {
      opacity: 0;
      pointer-events: none;
    }

    /* Main content area */
    .admin-main {
      margin-left: 220px;
      flex: 1;
      min-height: 100vh;
      background: #F6F6F6;
      display: flex;
      flex-direction: column;
    }
  </style>
</head>
<body>
  <div class="admin-loading" id="adminLoading">Verificando sesión...</div>

  <div class="admin-shell" id="adminShell">
    <AdminSidebar currentPath={currentPath} />
    <main class="admin-main">
      <slot />
    </main>
  </div>

  <!-- Toast styles -->
  <style>
    #toast-container {
      position: fixed;
      bottom: 28px;
      right: 28px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      z-index: 9999;
      pointer-events: none;
    }
    .toast {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 18px;
      background: #111111;
      color: #EEEEEE;
      font-family: 'Syne', sans-serif;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.2px;
      min-width: 260px;
      max-width: 380px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
      border-left: 3px solid #555;
      animation: toastIn 0.2s ease forwards;
      pointer-events: auto;
    }
    .toast.success { border-left-color: #22C55E; }
    .toast.error   { border-left-color: #EF4444; }
    .toast.info    { border-left-color: #3B82F6; }
    .toast.out     { animation: toastOut 0.2s ease forwards; }
    .toast-icon    { font-size: 15px; flex-shrink: 0; }
    @keyframes toastIn  { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes toastOut { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(8px); } }
  </style>
  <div id="toast-container"></div>

  <script>
    const API = 'http://localhost:4013';

    // ── Global toast ──────────────────────────────────────────────
    function _showToast(msg: string, type: 'success' | 'error' | 'info' = 'info', duration = 3500) {
      const container = document.getElementById('toast-container')!;
      const el = document.createElement('div');
      el.className = `toast ${type}`;
      const icons = { success: '✓', error: '✕', info: 'i' };
      el.innerHTML = `<span class="toast-icon">${icons[type]}</span><span>${msg}</span>`;
      container.appendChild(el);
      setTimeout(() => {
        el.classList.add('out');
        el.addEventListener('animationend', () => el.remove());
      }, duration);
    }
    (window as any).toast = {
      success: (m: string) => _showToast(m, 'success'),
      error:   (m: string) => _showToast(m, 'error'),
      info:    (m: string) => _showToast(m, 'info'),
    };

    // ── Admin init ────────────────────────────────────────────────
    async function initAdmin() {
      try {
        const res = await fetch(`${API}/auth/validate`, { credentials: 'include' });
        if (!res.ok) { window.location.href = '/login'; return; }

        const json = await res.json();
        const user = json?.data?.user ?? json?.user;

        const nameEl = document.getElementById('sidebarUserName');
        const roleChip = document.getElementById('sidebarRoleChip');
        const roleLabel = document.getElementById('sidebarRoleLabel');

        if (nameEl) nameEl.textContent = user.name ?? '';
        if (roleLabel) roleLabel.textContent = user.role ?? '';
        if (roleChip && user.role === 'GERENTE') roleChip.classList.add('gerente');

        document.getElementById('sidebarLogout')?.addEventListener('click', async () => {
          await fetch(`${API}/auth/logout`, { method: 'POST', credentials: 'include' }).catch(() => {});
          window.location.href = '/login';
        });

        document.getElementById('adminLoading')?.classList.add('hidden');
        document.getElementById('adminShell')?.classList.add('ready');

        document.dispatchEvent(new CustomEvent('arkan:auth-ready', { detail: user }));
      } catch {
        window.location.href = '/login';
      }
    }

    initAdmin();
  </script>
</body>
</html>
