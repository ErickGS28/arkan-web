---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import NavArkan from '../../components/arkan/NavArkan.astro';
import FooterArkan from '../../components/arkan/FooterArkan.astro';

const { slug } = Astro.params;
---

<Layout title="Blog — Arkán Group" description="">
  <NavArkan />

  <!-- Loading state -->
  <div id="postLoading" class="post-loading">
    <div class="loading-inner">
      <div class="loading-bar"></div>
    </div>
  </div>

  <!-- Post shell (populated by JS) -->
  <div id="postShell" style="display:none">
    <!-- Cover hero -->
    <div class="cover" id="postCover">
      <img id="coverImg" class="cover-img" alt="" />
      <div class="cover-overlay"></div>
      <div class="cover-content">
        <a href="/blog" class="back-link">← Blog</a>
        <div class="cover-meta" id="coverMeta"></div>
        <h1 class="cover-title" id="coverTitle"></h1>
      </div>
    </div>

    <!-- Artículo -->
    <article class="article">
      <p class="article-excerpt" id="articleExcerpt"></p>
      <div class="article-content" id="articleContent"></div>
    </article>

    <!-- Más artículos -->
    <section class="more" id="moreSection" style="display:none">
      <p class="more-label">Seguir leyendo</p>
      <div class="more-grid" id="moreGrid"></div>
      <a href="/blog" class="all-link">Ver todos los artículos →</a>
    </section>
  </div>

  <!-- Not found state -->
  <div id="postNotFound" class="not-found" style="display:none">
    <p>Artículo no encontrado.</p>
    <a href="/blog">← Volver al blog</a>
  </div>

  <FooterArkan />
</Layout>

<style>
  /* Loading */
  .post-loading {
    margin-top: 64px;
    height: 70vh;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0A0A0A;
  }
  .loading-inner { width: 120px; height: 2px; background: #1A1A1A; overflow: hidden; }
  .loading-bar {
    height: 100%;
    background: #444;
    animation: loadBar 1.2s ease-in-out infinite;
  }
  @keyframes loadBar {
    0% { width: 0; margin-left: 0; }
    50% { width: 60%; margin-left: 20%; }
    100% { width: 0; margin-left: 100%; }
  }

  /* Not found */
  .not-found {
    margin-top: 64px;
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    color: #777;
  }
  .not-found a {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #0A0A0A;
    font-weight: 600;
  }

  /* Cover */
  .cover {
    position: relative;
    height: 70vh;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: 64px;
  }
  .cover-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: grayscale(15%);
  }
  .cover-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0.2) 0%,
      rgba(0,0,0,0.55) 50%,
      rgba(0,0,0,0.92) 100%
    );
  }
  .cover-content {
    position: relative; z-index: 2;
    padding: 0 80px 60px;
    display: flex; flex-direction: column; gap: 16px;
    max-width: 900px;
  }
  .back-link {
    font-family: 'Syne', sans-serif;
    font-size: 11px; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase;
    color: #FFFFFF; opacity: 0.6;
    transition: opacity 0.2s ease;
  }
  .back-link:hover { opacity: 1; }
  .cover-meta {
    display: flex; align-items: center; gap: 8px;
    font-family: 'Syne', sans-serif;
    font-size: 11px; letter-spacing: 2px;
    color: #FFFFFF; opacity: 0.6; text-transform: uppercase;
  }
  .cover-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(36px, 5vw, 72px);
    letter-spacing: 3px; color: #FFFFFF;
    line-height: 1.05;
  }

  /* Artículo */
  .article {
    background: #FFFFFF;
    padding: 80px;
    max-width: 760px;
    margin: 0 auto;
  }
  .article-excerpt {
    font-family: 'Syne', sans-serif;
    font-size: 18px; font-weight: 600;
    line-height: 1.7; color: #0A0A0A;
    margin-bottom: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid #E0E0E0;
  }
  .article-content :global(p) {
    font-family: 'Syne', sans-serif;
    font-size: 16px; line-height: 1.9;
    color: #444; margin-bottom: 24px;
  }
  .article-content :global(h2) {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px; letter-spacing: 2px;
    color: #0A0A0A; margin: 48px 0 20px;
    line-height: 1;
  }

  /* Más artículos */
  .more {
    background: #0A0A0A;
    padding: 80px;
    text-align: center;
  }
  .more-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px; letter-spacing: 8px;
    color: #555; text-transform: uppercase;
    margin-bottom: 48px;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    margin-bottom: 48px;
    text-align: left;
  }
  .more-card {
    display: flex; gap: 20px; align-items: center;
    background: #111; padding: 24px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .more-card:hover { background: #161616; }
  .more-img {
    width: 80px; height: 80px;
    object-fit: cover; flex-shrink: 0;
    filter: grayscale(30%);
    background: #1A1A1A;
  }
  .more-body { display: flex; flex-direction: column; gap: 8px; }
  .more-date {
    font-family: 'Syne', sans-serif;
    font-size: 10px; letter-spacing: 2px;
    color: #555; text-transform: uppercase;
  }
  .more-title {
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 600;
    color: #F0F0F0; line-height: 1.5;
  }
  .all-link {
    font-family: 'Syne', sans-serif;
    font-size: 11px; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase;
    color: #FFFFFF; text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .all-link:hover { opacity: 0.7; }

  @media (max-width: 768px) {
    .cover { height: 55vh; min-height: 360px; }
    .cover-content { padding: 0 24px 40px; }
    .article { padding: 48px 24px; }
    .article-excerpt { font-size: 16px; }
    .article-content :global(h2) { font-size: 26px; }
    .more { padding: 60px 24px; }
    .more-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .cover { height: 50svh; }
    .article { padding: 36px 20px; }
    .more { padding: 48px 20px; }
    .more-card { padding: 16px; }
    .more-img { width: 64px; height: 64px; }
  }
</style>

<script define:vars={{ slug }}>
  const API = 'http://localhost:4013';

  function formatDate(iso) {
    if (!iso) return '';
    return new Date(iso).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
  }

  async function loadPost() {
    try {
      const res = await fetch(`${API}/blog/${slug}`);
      if (!res.ok) throw new Error('not found');
      const json = await res.json();
      const post = json?.data ?? json;

      // Update document title
      document.title = `${post.title} — Arkán Group`;

      // Populate cover
      const coverImg = document.getElementById('coverImg');
      if (post.coverImg) {
        coverImg.src = post.coverImg;
        coverImg.alt = post.title;
      } else {
        document.getElementById('postCover').style.background = '#0A0A0A';
      }

      const date = post.publishedAt ? formatDate(post.publishedAt) : '';
      document.getElementById('coverMeta').innerHTML = `
        ${date ? `<span>${date}</span><span style="opacity:0.4">·</span>` : ''}
        <span>${post.readTime} lectura</span>
      `;
      document.getElementById('coverTitle').textContent = post.title;
      document.getElementById('articleExcerpt').textContent = post.excerpt;
      document.getElementById('articleContent').innerHTML = post.content;

      // More posts
      const moreRes = await fetch(`${API}/blog`);
      if (moreRes.ok) {
        const moreJson = await moreRes.json();
        const allPosts = Array.isArray(moreJson) ? moreJson : (moreJson.data ?? []);
        const others = allPosts.filter(p => p.slug !== slug).slice(0, 2);
        if (others.length) {
          document.getElementById('moreGrid').innerHTML = others.map(p => `
            <a href="/blog/${p.slug}" class="more-card">
              ${p.coverImg ? `<img src="${p.coverImg}" alt="${p.title}" class="more-img" />` : '<div class="more-img"></div>'}
              <div class="more-body">
                <p class="more-date">${formatDate(p.publishedAt)}</p>
                <p class="more-title">${p.title}</p>
              </div>
            </a>
          `).join('');
          document.getElementById('moreSection').style.display = 'block';
        }
      }

      document.getElementById('postLoading').style.display = 'none';
      document.getElementById('postShell').style.display = 'block';
    } catch {
      document.getElementById('postLoading').style.display = 'none';
      document.getElementById('postNotFound').style.display = 'flex';
    }
  }

  loadPost();
</script>
