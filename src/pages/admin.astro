---
import AdminLayout from '../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard">
  <style>
    .page-header {
      padding: 28px 40px 24px;
      border-bottom: 1px solid #E8E8E8;
      background: #FFFFFF;
    }
    .page-header-label {
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #999999;
      margin-bottom: 4px;
    }
    .page-header-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 30px;
      letter-spacing: 3px;
      color: #111111;
    }

    .page-body {
      padding: 40px;
    }

    /* Greeting */
    .greeting-label {
      font-size: 12px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #999999;
      margin-bottom: 8px;
    }
    .greeting-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(44px, 6vw, 68px);
      letter-spacing: 2px;
      line-height: 1;
      color: #111111;
      margin-bottom: 16px;
    }

    /* Role chip */
    .role-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 16px;
      border: 1px solid #DDDDDD;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #777;
    }
    .role-chip.gerente {
      border-color: #111111;
      color: #111111;
    }
    .role-dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: #DDDDDD;
      flex-shrink: 0;
    }
    .role-chip.gerente .role-dot { background: #111111; }

    .divider {
      width: 32px;
      height: 1px;
      background: #E8E8E8;
      margin: 36px 0;
    }

    /* Info cards */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1px;
      background: #E8E8E8;
      border: 1px solid #E8E8E8;
      max-width: 520px;
    }
    .info-card {
      background: #FFFFFF;
      padding: 20px 24px;
    }
    .info-card-label {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #999999;
      margin-bottom: 8px;
    }
    .info-card-value {
      font-size: 15px;
      font-weight: 500;
      color: #222222;
      word-break: break-all;
    }
  </style>

  <div class="page-header">
    <p class="page-header-label">Panel Administrativo</p>
    <h1 class="page-header-title">Dashboard</h1>
  </div>

  <div class="page-body">
    <p class="greeting-label">Bienvenido de vuelta</p>
    <h2 class="greeting-name" id="dashGreetingName"></h2>
    <span class="role-chip" id="dashRoleChip">
      <span class="role-dot"></span>
      <span id="dashRoleLabel"></span>
    </span>

    <div class="divider"></div>

    <div class="info-grid">
      <div class="info-card">
        <p class="info-card-label">Email</p>
        <p class="info-card-value" id="dashEmail"></p>
      </div>
      <div class="info-card">
        <p class="info-card-label">Nombre</p>
        <p class="info-card-value" id="dashName"></p>
      </div>
      <div class="info-card">
        <p class="info-card-label">Rol</p>
        <p class="info-card-value" id="dashRole"></p>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('arkan:auth-ready', (e: Event) => {
      const user = (e as CustomEvent).detail;

      const name = document.getElementById('dashGreetingName');
      const email = document.getElementById('dashEmail');
      const nameCard = document.getElementById('dashName');
      const role = document.getElementById('dashRole');
      const roleLabel = document.getElementById('dashRoleLabel');
      const roleChip = document.getElementById('dashRoleChip');

      if (name) name.textContent = (user.name ?? '').toUpperCase();
      if (email) email.textContent = user.email ?? '';
      if (nameCard) nameCard.textContent = `${user.name ?? ''} ${user.lastName ?? ''}`.trim();
      if (role) role.textContent = user.role ?? '';
      if (roleLabel) roleLabel.textContent = user.role ?? '';
      if (roleChip && user.role === 'GERENTE') roleChip.classList.add('gerente');
    });
  </script>
</AdminLayout>
